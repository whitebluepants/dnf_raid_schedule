NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only secret: never expose this value through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Current-space selection uses a server-only HttpOnly cookie. Platform-admin
# bootstrap is migration-based and does not require a client-visible secret.

# Optional browser E2E opt-in. These are non-secret values; do not point this
# at a production project, because the suite creates its own users and space.
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_RUN_ID=local-001
